    {"id":"calc_ch2_01","type":"concept","subject":"gaoshu","chapter":"第二章 导数与微分","module":"导数","name":"导数定义","definition":"f'(x)=lim(Δx→0)[f(x+Δx)-f(x)]/Δx","difficulty":3,"importance":5,"examValue":5,"examScore":5,"frequency":5,"teacherFocus":5,"examFrequency":"high","mastery":"none","questionTypes":["计算","证明"],"prerequisite":["calc_ch1_03","calc_ch1_08"],"formula":{"name":"导数定义","latex":"f'(x)=\\lim_{\\Delta x\\to 0}\\frac{f(x+\\Delta x)-f(x)}{\\Delta x}"},"memoryTips":"可导⇒连续，但连续⇏可导（反例：y=|x|在x=0）","questions":[]},
    {"id":"calc_ch2_02","type":"formula","subject":"gaoshu","chapter":"第二章 导数与微分","module":"导数","name":"基本求导公式","definition":"幂函数、指数函数、对数函数、三角函数的导数","difficulty":2,"importance":5,"examValue":5,"examScore":5,"frequency":5,"teacherFocus":5,"examFrequency":"high","mastery":"none","questionTypes":["计算"],"prerequisite":["calc_ch2_01"],"formula":{"name":"基本求导公式","latex":"(x^n)'=nx^{n-1},\\;(e^x)'=e^x,\\;(\\ln x)'=\\frac{1}{x},\\;(\\sin x)'=\\cos x,\\;(\\cos x)'=-\\sin x"},"memoryTips":"反三角函数求导易忘：(arcsinx)'=1/√(1-x²)，(arctanx)'=1/(1+x²)","questions":[]},
