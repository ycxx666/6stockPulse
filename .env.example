# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
PG_DATABASE=stockpulse
PG_POOL_MIN=2
PG_POOL_MAX=10

# LLM (DeepSeek / OpenAI / Anthropic)
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your_llm_key_here
LLM_BASE_URL=https://api.deepseek.com

# Realtime (optional)
RT_REFRESH_SECONDS=60
GLOBAL_INDEX_INTERVAL=60
